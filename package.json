{
    "name": "accessibility-lab",
    "version": "0.1.0",
    "description": "Accessibility Lab — Features and Experiments for WordPress.",
    "license": "GPL-2.0-or-later",
    "private": true,
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "lint": "npm-run-all lint:*",
        "lint:css": "wp-scripts lint-style",
        "lint:js": "wp-scripts lint-js src",
        "lint:php": "composer run lint",
        "lint:phpstan": "composer phpstan",
        "format": "npm-run-all format:*",
        "format:css": "wp-scripts lint-style --fix",
        "format:js": "wp-scripts lint-js --fix",
        "format:php": "composer format"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": "wp-scripts lint-js",
        "src/**/*.{css,scss}": "wp-scripts lint-style",
        "includes/**/*.php": "vendor/bin/phpcs",
        "*.php": "vendor/bin/phpcs"
    },
    "devDependencies": {
        "@wordpress/env": "^11.13.0",
        "@wordpress/scripts": "32.6.0",
        "@wordpress/stylelint-config": "^24.1.0",
        "lint-staged": "^17.3.0",
        "npm-run-all": "^4.1.5"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "@wordpress/admin-ui": "2.6.0",
        "@wordpress/api-fetch": "7.44.0",
        "@wordpress/block-editor": "^16.1.0",
        "@wordpress/components": "32.6.0",
        "@wordpress/data": "10.44.0",
        "@wordpress/dataviews": "18.0.0",
        "@wordpress/editor": "^14.52.0",
        "@wordpress/element": "6.44.0",
        "@wordpress/hooks": "^4.52.0",
        "@wordpress/i18n": "6.17.0",
        "@wordpress/icons": "^15.3.0",
        "@wordpress/notices": "5.44.0",
        "@wordpress/plugins": "^7.52.0",
        "@wordpress/theme": "1.2.0"
    }
}
